# ───── Secrets ─────
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
.higgsfield/

# ───── Kişisel medya (public repoya asla girmez) ─────
# Ham çekimler, kimlik fotoğrafları ve tüm video projeleri yerelde / Drive'da kalır
assets/input/*
!assets/input/.gitkeep
assets/identity/
video-projects/
raw-media/
renders/*
!renders/.gitkeep
snapshots/
.hyperframes/

# Lisansı kişisel ses efektleri ve müzikler
Ses Efektleri/

# QA ses örnekleri (kendi sesim)
qa/**/*.wav
qa/**/*.mp3
qa/*.log

# ───── Makineye özel ─────
.claude/settings.local.json
.claude/skills/
.cache/
node_modules/

# ───── Medya güvenlik ağı (yanlışlıkla eklenmesin) ─────
*.mp4
*.mov
*.m4a
*.mkv
*.webm

# ───── OS / editör ─────
.DS_Store
**/.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# Python
__pycache__/
*.pyc
